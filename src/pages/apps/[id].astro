---
import type { PageContext } from '../../apps/_common/types';
import BarrioApp from '../../apps/barrios/App';
import ComparePlacesApp from '../../apps/compare-places/App';
import WhatsAppApp from '../../apps/whatsapp/App';
import Link from '../../components/elements/link.astro';
import Container from '../../components/page-container.astro';
import { getAllBarrios } from '../../data/apps/barrios';
import Layout from '../../layouts/layout.astro';
import { getPlaces } from '../../services/place.service';
import Apps, { getAppById } from './_data';

export function getStaticPaths() {
  return Apps.map((app) => ({
    params: { id: app.id },
    props: app,
  }));
}

const page = Astro.props;
const app = getAppById(page.id);

const pageContext: PageContext = {
  barrios: getAllBarrios(),
};

// put in a page context file...

if (app?.id === 'compare-places') {
  const data = await getPlaces();
  pageContext.places = data ?? [];
}
---
{
  app ? (
    <Layout title={app.title}>
      <Container>
        <div class="max-w-none mx-auto mt-24">
          <div class="flex justify-start">
            <Link href="/apps" style="outline">&lsaquo; All apps</Link>
          </div>
          <div class="prose prose-lg my-12 max-w-none">
            <h1>{app.title}</h1>
            <div set:html={app.description} />
            {
              app.id === 'barrio-lookup' && (
                <BarrioApp client:load  {...pageContext} />
              )
            }
            {
              app.id === 'compare-places' && (
                <ComparePlacesApp client:only="preact" {...pageContext} />
              )
            }
            {
              app.id === 'whatsapp-recommendations' && (
                <WhatsAppApp client:only="preact" {...pageContext} />
              )
            }
          </div>
        </div>
      </Container>
    </Layout>
  ) : (
    <Layout title="App not found">
      <Container>
        <div class="max-w-7xl mx-auto mt-24">
          <div class="prose prose-lg my-12">
            <h1>404 - Not found</h1>
            <p>We could not find that app.</p>
          </div>
        </div>
      </Container>
    </Layout>
  )
}
