---
import { Image } from "astro:assets";
import bcnImage from "../assets/barcelona-old-town.jpg";
import Link from "./elements/link.astro";
// Picture tag sizes: https://webdesign.tutsplus.com/quick-tip-how-to-use-html5-picture-for-responsive-images--cms-21015t#toc-kl8w-using-sizes-to-control-image-layout
---

<div
  class="relative overflow-hidden flex items-end justify-center px-[20px] py-4 aspect-square lg:aspect-16/9 h-full max-h-screen min-w-full mx-auto"
>
  <div class="absolute inset-0 w-full h-[inherit] max-h-[inherit] z-0 aspect-[inherit]">
    <Image
      src={bcnImage}
      alt="Restaurant in Barcelona old town"
      class:list={"w-full h-full aspect-4/3 object-cover"}
      quality={"mid"}
      loading={"lazy"}
      format="avif"
    />
  </div>
  <div class="z-[1] grid grid-cols-1 lg:grid-cols-3 lg:place-items-center lg:pb-8 max-h-[92vh] lg:max-h-full max-w-full lg:max-w-7xl mx-auto">
    <div class="max-w-6xl mx-auto">
      <h1
        class="text-3xl md:text-5xl lg:text-7xl xl:text-8xl font-semibold leading-tighter text-white text-center lg:text-left"
      >
        Barcelona <br class="hidden lg:block" />tips<br /> <span class="text-[#F6FB0F]">from a local</span><br />
        <!-- <span
          class="font-normal text-xl md:text-3xl lg:text-4xl tracking-normal !leading-none"
          >🚀 Tips by a local resident</span
        > -->
      </h1>

      <div class="mt-4 mb-6 lg:mt-8 flex flex-col lg:flex-row gap-3">
        <Link
          size="lg"
          style="outline"
          href="/blog"
          class="flex gap-1 items-center justify-center"
        >
          Explore the blog
        </Link>
      </div>
    </div>
  </div>
</div>
