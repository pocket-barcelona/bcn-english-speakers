---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
// import Avatar from '../../components/avatar.astro';
import Tag from '../../components/elements/tag.astro';
import PostCategoryTag from '../../components/post-category-tag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
}

const { post, index } = Astro.props;
---

<li class="p-2 shadow-xs hover:shadow-lg 2xl:hover:scale-105 border border-zinc-200 transition">
  <a href={`/blog/${post.id}`}>
    <div class="grid md:grid-cols-2 gap-2 md:gap-8 xl:gap-6 items-start relative">
      <Image
        src={post.data.cover}
        alt={post.data.coverAlt}
        sizes="(max-width: 767px) 700px, 428px"
        class:list={"w-full aspect-4/3 object-cover shadow-md"}
        decoding={"async"}
        widths={[700, 428]}
        width={428}
        height={240}
        quality={"mid"}
        loading={index >= 3 ? "lazy" : "eager"}
        format="avif"
      />
      {post.data.updatedDate && (
        <Tag color="warning" size="small" class="top-2 absolute ml-2 z-10">
          Updated
        </Tag>
      )}
      <div>
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 pr-1">
          <PostCategoryTag category={post.data.category} />
          <div class="flex gap-2 items-start justify-end mt-1 text-zinc-500">
            { /*
            <Avatar
              authorId={post.data.authorId}
              authorName={post.data.author}
            />
            <span class="text-gray-700 text-sm">
              by {post.data.author}
            </span>
            <span class="text-gray-700 text-sm">• </span>
            */ }
            <time
              class="text-xs italic"
              datetime={post.data.publishDate.toISOString()}
            >
              {post.data.publishDate.toDateString()}
            </time>
          </div>
        </div>

        <h2 class="text-2xl xl:text-3xl font-bold leading-tight tracking-tight mt-1.5">
          {post.data.title}
        </h2>
        <p class="text-sm md:text-base mt-4 line-clamp-6 xl:line-clamp-3">
          {post.data.snippet}
        </p>
      </div>
    </div>
  </a>
</li>