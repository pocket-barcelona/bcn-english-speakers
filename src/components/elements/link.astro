---
interface Props {
  href: string;
  size?: "md" | "lg" | "xl";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted" | "success";
  class?: string;
  [x: string]: unknown;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-2 md:px-4 py-1 md:py-2 text-xs",
  lg: "px-3 md:px-5 py-1.5 md:py-2.5 text-md md:text-lg",
  xl: "px-4 md:px-6 py-2 md:py-3 text-lg md:text-xl",
};

const styles = {
  outline: "bg-white border-2 border-black hover:bg-gray-100 text-black ",
  primary: "bg-black text-white hover:bg-gray-800  border-2 border-transparent",
  inverted: "bg-white text-black   border-2 border-transparent",
  muted: "bg-gray-100 hover:bg-gray-200   border-2 border-transparent",
  success: "bg-[#25D366] hover:bg-[#15C356] text-white border-2 border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded-lg text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
